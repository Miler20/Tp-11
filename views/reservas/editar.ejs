<section class="panel-formulario">
  <p class="etiqueta">Reservas de salas · Edición completa</p>
  <h1><%= titulo %></h1>

  <% if (error) { %>
    <p class="error" role="alert"><%= error %></p>
  <% } %>

  <form class="formulario" action="/reservas/<%= id %>/editar" method="post">
    <label for="estudiante">Estudiante</label>
    <input id="estudiante" name="estudiante" type="text" required value="<%= valores.estudiante ?? '' %>">

    <label for="email">Email</label>
    <input id="email" name="email" type="email" required value="<%= valores.email ?? '' %>">

    <label for="sala">Sala</label>
    <select id="sala" name="sala" required>
      <option value="">Seleccioná una sala</option>
      <% ["Sala Norte", "Sala Sur", "Sala Multimedia"].forEach((sala) => { %>
        <option value="<%= sala %>" <%= valores.sala === sala ? "selected" : "" %>><%= sala %></option>
      <% }) %>
    </select>

    <label for="fecha">Fecha</label>
    <input id="fecha" name="fecha" type="date" required value="<%= valores.fecha ?? '' %>">

    <label for="turno">Turno</label>
    <select id="turno" name="turno" required>
      <option value="">Seleccioná un turno</option>
      <% ["Mañana", "Tarde", "Noche"].forEach((turno) => { %>
        <option value="<%= turno %>" <%= valores.turno === turno ? "selected" : "" %>><%= turno %></option>
      <% }) %>
    </select>

    <label for="personas">Cantidad de personas</label>
    <input id="personas" name="personas" type="number" min="1" max="6" step="1" required value="<%= valores.personas ?? '' %>">

    <label for="estado">Estado</label>
    <select id="estado" name="estado" required>
      <option value="pendiente" <%= valores.estado === "pendiente" ? "selected" : "" %>>Pendiente</option>
      <option value="confirmada" <%= valores.estado === "confirmada" ? "selected" : "" %>>Confirmada</option>
    </select>

    <button type="submit">Guardar cambios</button>
    <a href="/reservas/<%= id %>">Cancelar</a>
  </form>
  <p><small>Se reemplazan los siete campos editables. El identificador de la reserva se conserva.</small></p>
</section>
